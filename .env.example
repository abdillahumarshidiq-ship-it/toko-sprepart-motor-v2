# Salin file ini ke .env dan sesuaikan nilainya

# Database URL — SQLite lokal (default untuk development)
DATABASE_URL="file:./db/custom.db"

# Kredensial admin untuk login (ganti dengan password kuat di produksi)
ADMIN_EMAIL="admin@sijambulmerah.id"
ADMIN_PASSWORD="ganti-password-kuat-disini"

# NextAuth secret — generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-random-string-32-char"
NEXTAUTH_URL="http://localhost:3000"
